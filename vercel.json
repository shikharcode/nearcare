{
  "framework": "nextjs",
  "crons": [
    { "path": "/api/reminders/send", "schedule": "0 8 * * *" },
    { "path": "/api/digest/weekly", "schedule": "0 9 * * 1" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
